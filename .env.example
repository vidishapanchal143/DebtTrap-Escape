# Create your own Gemini API key and set it only in .env.local / deployment secrets.
# Do not commit a real key. Current recommended text model supports function calling.
GEMINI_API_KEY=
GEMINI_MODEL_AGENT=gemini-3.8-flash

# Optional: Ethereum Sepolia RPC & Contract Configuration (for Hardhat / EvidenceHashRegistry)
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# DEPLOYER_PRIVATE_KEY=your_testnet_private_key
# EVIDENCE_HASH_REGISTRY_ADDRESS=0x8638143982BfddAc9a8c60A49A6d119c5a607aBd
